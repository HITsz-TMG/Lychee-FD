COMPOSE_PROJECT_NAME=lychee_fd

# Image names.
LYCHEE_FD_IMAGE=ghcr.io/hitsz-tmg/lychee-fd:latest
LYCHEE_FD_BASE_IMAGE=lychee-fd-early-exit-flash-attn:dev

# Host paths. The container always sees the model root as /models.
HOST_MODEL_ROOT=/path/to/model-root
CONTAINER_MODEL_ROOT=/models
ALLOWED_MODEL_ROOT=/models
PRESETS_FILE_HOST=./model_presets_dev.json

# GPU visibility inside containers.
BACKEND_CUDA_VISIBLE_DEVICES=1
TOKEN2WAV_CUDA_VISIBLE_DEVICES=0

# Main backend.
FRONTEND_PORT=8084
LYCHEEFD_SERVER_PORT=7860
LYCHEEFD_MODEL_PATH=/models/lychee_full_duplex_v1.5
LYCHEEFD_USE_VLLM=1
LYCHEEFD_BACKEND=vllm
AUTO_LOAD_DEFAULT=0
LYCHEEFD_REALTIME_STRICT_INFER_WINDOW=1
LYCHEEFD_REALTIME_INFER_WINDOW_MS=400
LYCHEEFD_REALTIME_INFER_WINDOW_MIN_MS=200
LYCHEEFD_WINDOW_SECOND=0.4
LYCHEEFD_STOKEN_DELAY_NUM=10
LYCHEEFD_TTS_VOCODER_HOP_SIZE=10
LYCHEEFD_T2W_STREAM_LOOKAHEAD_LEN=3
LYCHEEFD_VLLM_MAX_MODEL_LEN=16384
LYCHEEFD_VLLM_GPU_MEMORY_UTILIZATION=0.90
LYCHEEFD_VLLM_SIDE_PARALLEL_BRANCH=0

# Remote token2wav sidecar.
LYCHEEFD_T2W_SERVER_PORT=8091
LYCHEEFD_T2W_MODEL_PATH=/models/token2wav
LYCHEEFD_T2W_REMOTE_ENABLED=1
LYCHEEFD_T2W_REMOTE_URL=http://token2wav:8091
LYCHEEFD_T2W_REMOTE_FALLBACK=0
