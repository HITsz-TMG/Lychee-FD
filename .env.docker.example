COMPOSE_PROJECT_NAME=lychee_fd

# Image names.
LYCHEE_FD_IMAGE=ghcr.io/your-github-username/lychee-fd:latest
LYCHEE_FD_BASE_IMAGE=lychee-fd-early-exit-backend:dev

# Host paths. The container always sees the model root as /data/zxy/model.
HOST_MODEL_ROOT=/path/to/model-root
ALLOWED_MODEL_ROOT=/data/zxy/model
PRESETS_FILE_HOST=./model_presets_dev.json

# GPU visibility inside containers.
BACKEND_CUDA_VISIBLE_DEVICES=1
TOKEN2WAV_CUDA_VISIBLE_DEVICES=0

# Main backend.
FRONTEND_PORT=8084
STEPAUDIO_SERVER_PORT=7860
STEPAUDIO_MODEL_PATH=/data/zxy/model/path/to/lychee-fd/checkpoint
STEPAUDIO_USE_VLLM=1
STEPAUDIO_BACKEND=vllm
AUTO_LOAD_DEFAULT=0
STEPAUDIO_REALTIME_STRICT_INFER_WINDOW=1
STEPAUDIO_REALTIME_INFER_WINDOW_MS=400
STEPAUDIO_REALTIME_INFER_WINDOW_MIN_MS=200
STEPAUDIO_WINDOW_SECOND=0.4
STEPAUDIO_STOKEN_DELAY_NUM=10
STEPAUDIO_TTS_VOCODER_HOP_SIZE=10
STEPAUDIO_T2W_STREAM_LOOKAHEAD_LEN=3
STEPAUDIO_VLLM_MAX_MODEL_LEN=16384
STEPAUDIO_VLLM_TAIL_TRUNCATE_ENABLED=0
STEPAUDIO_REALTIME_DEBUG=0
VUE_APP_REALTIME_DEBUG=0

# Remote token2wav sidecar.
STEPAUDIO_T2W_SERVER_PORT=8091
STEPAUDIO_T2W_MODEL_PATH=/data/zxy/model/token2wav
STEPAUDIO_T2W_REMOTE_ENABLED=1
STEPAUDIO_T2W_REMOTE_URL=http://token2wav:8091
STEPAUDIO_T2W_REMOTE_FALLBACK=0

# Optional SoulX sidecar.
STEPAUDIO_SOULX_ENABLED=0
STEPAUDIO_SOULX_IDLE_COMPACT_ENABLED=0
