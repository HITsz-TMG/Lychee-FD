# Copy this file to .env.avatar and replace every /path/to value.
# .env.avatar is ignored by Git.

# Python environment directories (each must contain bin/python).
LIVEACT_ENV=/path/to/liveact-avatar-env
FD_ENV=/path/to/lychee-fd-env

# Parent directory containing the model directories listed below.
MODEL_ROOT=/path/to/models

# Optional model path overrides. Defaults are derived from MODEL_ROOT.
# LIVEACT_CKPT_DIR=/path/to/models/LiveAct
# LIVEACT_WAV2VEC_DIR=/path/to/models/chinese-wav2vec2-base
# LYCHEEFD_MODEL_PATH=/path/to/models/lychee_full_duplex
# LYCHEEFD_T2W_MODEL_PATH=/path/to/models/Step-Audio-2-mini/token2wav

# Optional GPU allocation for a four-GPU machine.
AVATAR_GPU=0,1
FD_GPU=2
TOKEN2WAV_GPU=3
